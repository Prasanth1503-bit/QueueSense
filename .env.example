# ==============================================================================
# QueueSense Environment Configuration
# Copy this file to '.env' and adjust variables as needed for your environment.
# ==============================================================================

# Supabase PostgreSQL Cloud Database
# Copy from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# e.g., postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# Local SQLite Database (Used automatically if DATABASE_URL is empty)
# QUEUESENSE_DB_PATH=queuesense.db

# Web Server Settings
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
WAITRESS_THREADS=8

# Arduino & Hardware Settings
# Auto-detects port if left empty. On Windows: COM3, COM4, etc. On Linux: /dev/ttyUSB0, /dev/ttyACM0
QUEUESENSE_ARDUINO_PORT=
# Set to 'false' if deploying on cloud servers without physical Arduino hardware connected
ENABLE_ARDUINO=true

# Queue Intelligence Settings
# Average service duration per person (seconds) used to estimate wait time
SERVICE_SECONDS_PER_PERSON=25
